# InfoFlowAggregator standalone deployment template.
# Copy this file to deploy/.env beside docker-compose.yml before running docker compose.
# This file is for Docker Compose deployment, not local development.

# Optional: override image repository.
# By default, compose uses:
# ghcr.io/mrericking/infoflow-aggregator
# IMAGE_NAME=ghcr.io/yourname/your-image
IMAGE_TAG=latest

# Optional rollback tag used by update.ps1 when an update fails.
# Prefer immutable tags such as sha-abcdef0 for production updates.
PREVIOUS_IMAGE_TAG=

# Host binding. Keep 127.0.0.1 for local/VPN/reverse-proxy access only.
APP_HOST_BIND=127.0.0.1
APP_PORT=5173
RSSHUB_HOST_BIND=127.0.0.1
RSSHUB_PORT=1200
# Add your Cloudflare Access hostname when publishing through Tunnel.
# Example: CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://infoflow.example.com
# Do not use CORS_ORIGINS=* with ENVIRONMENT=production; the app rejects wildcard production CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Current production compose is intended for localhost/VPN/reverse-proxy access control.
# This acknowledgement is required until backend authentication is implemented.
INFOFLOW_ALLOW_UNAUTHENTICATED_PRODUCTION_API=true

# PostgreSQL canonical store.
# Fresh official postgres containers require a password unless using unsafe trust auth.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=infoflowaggregator

# Required before saving AI provider API keys in app settings.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INFOFLOW_SETTINGS_ENCRYPTION_KEY=replace-with-fernet-key
# Optional env overrides; these take precedence over encrypted app settings.
# INFOFLOW_AI_GENERAL_API_KEY=replace-with-general-provider-key
# INFOFLOW_AI_SENSITIVE_API_KEY=replace-with-sensitive-provider-key

# InfoFlowAggregator resolves RSSHub from inside the Docker network.
RSSHUB_BASE_URL=http://rsshub:1200

# Host-side storage directories mounted into the app container.
# Defaults keep generated files beside docker-compose.yml.
# Use absolute host paths here if you want the files outside the deploy directory.
HOST_KNOWLEDGE_BASE_ROOT=./KnowledgeBase

# Optional SingleFile MV3 extension capture timeout override.
# The image supplies extension path/id/browser defaults internally.
SINGLEFILE_CAPTURE_TIMEOUT_SECONDS=120

# RSSHub runtime.
# RSSHub reads these exact environment variable names.
# Keep RSSHub internal to the compose network; do not expose port 1200 unless you need direct debugging.
CACHE_TYPE=redis
CACHE_EXPIRE=120
CACHE_CONTENT_EXPIRE=1800
REDIS_URL=redis://redis:6379/

# RSSHub route credentials passed through by deploy/docker-compose.yml.
# Keep a variable here and under rsshub.environment when a route needs it.
# Replace placeholders in deploy/.env. Keep real tokens out of git.
TWITTER_AUTH_TOKEN=replace-with-twitter-auth-token
YOUTUBE_KEY=replace-with-youtube-api-key

# More examples you can add here and under rsshub.environment:
# GITHUB_ACCESS_TOKEN=replace-with-github-access-token
# PIXIV_REFRESHTOKEN=replace-with-pixiv-refresh-token
# ZHIHU_COOKIES=replace-with-zhihu-cookies
